# Copy to backend/.env and fill in your own values.
# Generate a strong random value for SECRET_KEY before use beyond local development.
SECRET_KEY=replace-with-a-long-random-secret
DB_PATH=./creative_brief.db
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EXTERNAL_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional local semantic search (needs: python -m pip install -r requirements-semantic.txt)
SEMANTIC_SEARCH=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
